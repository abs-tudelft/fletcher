digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir="LR";
  Node0 [id="Node000000",label="Component",height=0.2,width=0.4,color="grey60", fillcolor="#E0E0E0", style="filled",tooltip=" "];
  Node0 -> Node1 [id="edge2_Node000000_Node000001",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node1 [id="Node000001",label="fletchgen::Kernel",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$structfletchgen_1_1_kernel.html",tooltip="The Kernel component to be implemented by the user."];
  Node0 -> Node2 [id="edge3_Node000000_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="fletchgen::Mantle",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classfletchgen_1_1_mantle.html",tooltip="A component that wraps a Kernel and all ArrayReaders/Writers resulting from a Schema set."];
  Node0 -> Node3 [id="edge4_Node000000_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="fletchgen::Nucleus",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$structfletchgen_1_1_nucleus.html",tooltip="It's like a kernel, but there is a kernel inside."];
  Node0 -> Node4 [id="edge5_Node000000_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="fletchgen::RecordBatch",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$structfletchgen_1_1_record_batch.html",tooltip="A RecordBatch aggregating ArrayReaders/Writers."];
}
